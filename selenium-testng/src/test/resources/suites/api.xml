<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Suite" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="io.github.rendyyy.qa.selenium.listeners.TestListener"/>
        <listener class-name="io.github.rendyyy.qa.selenium.listeners.RetryTransformer"/>
        <listener class-name="io.github.rendyyy.qa.selenium.listeners.AllureEnvironmentListener"/>
    </listeners>
    <test name="API">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="io.github.rendyyy.qa.selenium.tests.api"/>
        </packages>
    </test>
</suite>