<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Hybrid Suite" parallel="methods" thread-count="1">
    <listeners>
        <listener class-name="io.github.rendyyy.qa.selenium.listeners.TestListener"/>
        <listener class-name="io.github.rendyyy.qa.selenium.listeners.RetryTransformer"/>
        <listener class-name="io.github.rendyyy.qa.selenium.listeners.AllureEnvironmentListener"/>
    </listeners>
    <test name="Hybrid">
        <groups>
            <run>
                <include name="hybrid"/>
            </run>
        </groups>
        <packages>
            <package name="io.github.rendyyy.qa.selenium.tests.hybrid"/>
        </packages>
    </test>
</suite>